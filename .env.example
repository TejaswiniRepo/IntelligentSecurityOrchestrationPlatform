# ISOP configuration. Copy to .env (git-ignored). Real environment variables override this file.
# Placeholders only - never commit real secrets.

# ---- Investigation planner ------------------------------------------------------------
# ollama (default, local) | deterministic (no LLM) | anthropic (optional, cloud) | huggingface (optional, cloud)
LLM_PROVIDER=ollama
# deterministic: on LLM failure use the rule-based planner, labelled "deterministic_fallback"
# error:         on LLM failure return HTTP 503
LLM_FALLBACK=deterministic
LLM_TIMEOUT_S=45
LLM_TEMPERATURE=0
LLM_MAX_ITERATIONS=3
LLM_COOLDOWN_S=30
# true = refuse cloud providers and any non-loopback model endpoint
ISOP_OFFLINE=true

# ---- Local model (Ollama) ---------------------------------------------------------------
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=hf.co/Qwen/Qwen2.5-3B-Instruct-GGUF:Q4_K_M
OLLAMA_NUM_CTX=4096
OLLAMA_KEEP_ALIVE=30m

# ---- Optional cloud providers (require ISOP_OFFLINE=false and internet) ----------------
# A Claude Max / claude.ai subscription does NOT include API access; API keys are billed separately.
# ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
ANTHROPIC_EFFORT=low
# HF_TOKEN=
HF_MODEL=Qwen/Qwen2.5-7B-Instruct
HF_BASE_URL=https://router.huggingface.co/v1

# ---- Tools / policy / audit ------------------------------------------------------------
ISOP_TOOL_TRANSPORT=stdio
ISOP_TOOL_TIMEOUT_S=3.0
ISOP_MAX_FOLLOW_UPS=4
ISOP_POLICY_PATH=config/policy.json
ISOP_AUDIT_DB=var/audit.db
